# LINKY API Server — environment variables
# Copy to .env and fill in real values before going live.

# Port the API server listens on (Replit assigns this automatically per artifact).
PORT=8080

# ----------------------------------------------------------------------------
# Required secrets
# ----------------------------------------------------------------------------

# PostgreSQL connection string. In Replit, this is auto-populated when you
# create a database (Tools → Database). Do not set manually in Replit.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# HMAC secret for signed session tokens. MUST be at least 32 characters.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string-32-chars-min

# ----------------------------------------------------------------------------
# Coinbase Developer Platform (CDP)
# ----------------------------------------------------------------------------

# Your CDP API key for server-side Coinbase calls (webhook verification, future
# CDP integrations). Get it at https://developer.coinbase.com → New Project → API Keys.
# The same key used as VITE_ONCHAINKIT_API_KEY on the frontend can be reused here.
CDP_API_KEY=your_cdp_api_key_here

# ----------------------------------------------------------------------------
# Onchain config (Base mainnet by default)
# ----------------------------------------------------------------------------

# Which Base network to use. "mainnet" (default) → Base Mainnet (chainId 8453).
# Use "base-sepolia" only for local/testnet development.
BASE_CHAIN=mainnet

# Optional: custom RPC URL. Falls back to the chain's default public RPC.
# BASE_RPC_URL=https://mainnet.base.org

# LinkyEscrow contract address on the selected chain. REQUIRED for payments.
# Until this is set to a deployed contract, the /api/config endpoint reports
# escrowAddress: null and the frontend disables the Pay button.
LINKY_ESCROW_ADDRESS=0xYourDeployedEscrowContractAddress

# Treasury wallet that receives the platform fee. REQUIRED for production.
# If unset, fees route to a burn address (0x…dEaD) — fine for local dev,
# never for production.
TREASURY_ADDRESS=0xYourTreasuryWalletAddress

# Optional overrides — sensible defaults applied if omitted.
# USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913   # Base mainnet USDC
# PLATFORM_FEE_BPS=500                                       # 5%
# REFUND_DELAY_SECONDS=604800                                # 7 days
